# Virtual environment (rebuilt from uv.lock with `uv sync`)
.venv/

# Python bytecode and build output
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# Local databases
*.db
*.db-journal
*.db-wal
*.db-shm

# Test, coverage and tooling caches
.pytest_cache/
.hypothesis/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Web: dependencies, build output and Playwright's reports (web/node_modules is reflinked from
# the pnpm store, so it must never be committed)
web/node_modules/
web/**/node_modules/
web/packages/*/dist/
web/examples/*/dist/
web/playwright-report/
web/test-results/
web/playwright/.cache/
# (The e2e run's session cookie: it is the run's, not the repo's.)
web/playwright/.auth/
# (And the fake GitHub's address and token, which the harness writes for the tests.)
web/playwright/.e2e-github.json
src/udl/interfaces/web/dist/
src/udl/plugins/integrations/*/ui/*.js
src/udl/plugins/integrations/*/ui/*.map
# 29.2: the orchestrator's own UI, as `make web` builds it (a bundle's folder, whole)
src/udl/plugins/apps/*/ui/

# Test coverage and TypeScript build output
web/packages/*/coverage/
web/examples/*/coverage/
web/plugins/*/coverage/
