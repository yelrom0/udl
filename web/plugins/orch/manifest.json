{
	"name": "orch",
	"version": "0.1.0",
	"sdk": "^1.1",
	"entry": "index.js",
	"styles": ["index.css"],
	"isolation": "shadow",
	"contributes": {
		"nav": [
			{ "title": "Inbox", "route": "inbox", "icon": "inbox" },
			{ "title": "Board", "route": "board", "icon": "layout-dashboard" },
			{ "title": "Progress", "route": "progress", "icon": "chart-line" },
			{ "title": "Agents", "route": "agents", "icon": "users" },
			{ "title": "Q&A", "route": "questions", "icon": "message-circle-question" },
			{ "title": "Merge", "route": "merge", "icon": "git-pull-request" },
			{ "title": "To action", "route": "actions", "icon": "list-checks" }
		],
		"routes": [
			"inbox",
			"board",
			"progress",
			"features/$key",
			"tasks/$key",
			"agents",
			"agents/$name",
			"questions",
			"questions/$key",
			"merge",
			"actions"
		],
		"widgets": [{ "slot": "dashboard", "id": "orch" }],
		"panels": [{ "id": "chat", "title": "Chat", "icon": "message-square", "shortcut": "Ctrl+J" }]
	},
	"generated": {
		"tabs": ["settings", "operations"],
		"hide": ["orch_*"],
		"show": [
			"orch_list_runners",
			"orch_runner_*",
			"orch_list_projects",
			"orch_get_project",
			"orch_set_project",
			"orch_set_auto_merge",
			"orch_delete_project",
			"orch_set_repo",
			"orch_delete_repo",
			"orch_import_plan"
		]
	}
}
