{
	"name": "@udl/plugin-template",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "A starting point for a udl UI plugin: React, daisyUI and the SDK, with its own Vite build.",
	"scripts": {
		"build": "vite build",
		"dev": "vite build --watch",
		"test": "tsc --noEmit && vitest run --coverage"
	},
	"dependencies": {
		"@udl/ui-sdk": "workspace:*",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react-swc": "4.3.3",
		"@vitest/coverage-v8": "5.1.0",
		"daisyui": "5.8.1",
		"jsdom": "31.0.1",
		"tailwindcss": "4.3.5",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	}
}
